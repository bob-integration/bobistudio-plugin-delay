{
  "license": "GPL-3.0-or-later",
  "type": "delay",
  "label": "Délai",
  "runtime": "docker",
  "badge": {
    "label": "Délai",
    "class": "mode-corrector",
    "oklch": "0.80 0.05 110"
  },
  "version": "0.7.0",
  "adapts_input": true,
  "description": "Ligne à retard N→N : X entrées vidéo/audio retardées de D images vers X sorties correspondantes. Délai global ou par canal, réglé en images, piloté à chaud (page Traitements). Vidéo seul (défaut), vidéo + audio, ou audio seul.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/delay",
    "order": 50
  },
  "script_template": "script.py",
  "video_format": false,
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "n_channels": 1,
    "mode": "video",
    "max_delay_frames": 25,
    "delay_frames": 0
  },
  "config_schema": [
    {
      "key": "n_channels",
      "type": "number",
      "label": "Nombre de canaux",
      "min": 1,
      "max": 16,
      "default": 1
    },
    {
      "key": "mode",
      "type": "select",
      "label": "Essence",
      "default": "video",
      "options": [
        {
          "value": "video",
          "label": "Vidéo seul"
        },
        {
          "value": "video_audio",
          "label": "Vidéo + audio"
        },
        {
          "value": "audio",
          "label": "Audio seul"
        }
      ]
    },
    {
      "key": "max_delay_frames",
      "type": "number",
      "label": "Délai max (images vidéo · ms si audio seul)",
      "min": 1,
      "max": 10000,
      "default": 25
    },
    {
      "key": "delay_frames",
      "type": "number",
      "label": "Délai initial (images vidéo · ms si audio seul)",
      "min": 0,
      "max": 10000,
      "default": 0,
      "scope": "user"
    }
  ],
  "wiring": {
    "produces": [
      {
        "repeat": "video_channels",
        "essence": "video",
        "shm": "{hostname}_{i}",
        "label": "Sortie V{i1}"
      },
      {
        "repeat": "audio_channels",
        "essence": "audio",
        "shm": "{hostname}_audio_{i}",
        "label": "Sortie A{i1}"
      }
    ],
    "consumes": [
      {
        "repeat": "video_channels",
        "essence": "video",
        "state_field": "input_v_{i}",
        "label": "Entrée V{i1}"
      },
      {
        "repeat": "audio_channels",
        "essence": "audio",
        "state_field": "input_a_{i}",
        "label": "Entrée A{i1}"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "endpoints": [
      "/state",
      "/params",
      "/input"
    ]
  },
  "actions": [
    {
      "id": "set_delay",
      "label": "Régler le retard (global)",
      "endpoint": "/params",
      "body": {
        "all": true
      },
      "params": [
        {
          "key": "delay_frames",
          "label": "Retard (images)",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "set_delay_channel",
      "label": "Régler le retard d'un canal",
      "endpoint": "/params",
      "params": [
        {
          "key": "channel",
          "label": "Canal (1er = 0)",
          "type": "number",
          "default": 0
        },
        {
          "key": "delay_frames",
          "label": "Retard (images)",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "link",
      "label": "Lier les canaux",
      "endpoint": "/params",
      "params": [
        {
          "key": "link",
          "label": "Liés",
          "type": "bool",
          "default": true
        }
      ],
      "feedback": {
        "state": "link",
        "value_from": "link"
      }
    }
  ],
  "state": [
    {
      "id": "link",
      "label": "Canaux liés",
      "endpoint": "/state",
      "path": "link",
      "type": "bool"
    }
  ]
}

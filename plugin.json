{
  "license": "GPL-3.0-or-later",
  "type": "delay",
  "label": "Délai",
  "runtime": "docker",
  "badge": {
    "label": "Délai",
    "class": "mode-corrector",
    "oklch": "0.80 0.05 110"
  },
  "version": "0.14.5",
  "adapts_input": true,
  "description": "Ligne à retard N→N : X entrées vidéo/audio retardées vers X sorties correspondantes. Image et son COUPLÉS (une consigne) ou DÉCOUPLÉS (image en images, son en ms). Délai global ou par canal, piloté à chaud et par macro. Vidéo seul (défaut), vidéo + audio, ou audio seul.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements",
    "order": 40
  },
  "script_template": "script.py",
  "video_format": false,
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "n_channels": 1,
    "mode": "video",
    "max_delay_frames": 25,
    "delay_frames": 0,
    "log_level": "info",
    "av_link": true,
    "delay_ms_a": 0
  },
  "config_schema": [
    {
      "key": "n_channels",
      "type": "number",
      "label": "Nombre de canaux",
      "min": 1,
      "max": 16,
      "default": 1
    },
    {
      "key": "mode",
      "type": "select",
      "label": "Essence",
      "default": "video",
      "options": [
        {
          "value": "video",
          "label": "Vidéo seul"
        },
        {
          "value": "video_audio",
          "label": "Vidéo + audio"
        },
        {
          "value": "audio",
          "label": "Audio seul"
        }
      ]
    },
    {
      "key": "av_link",
      "type": "checkbox",
      "label": "Image et son couplés",
      "help": "Couplé (défaut) : une seule consigne règle l'image et le son — le son suit l'image, converti par la période vidéo mesurée. Découplé : deux consignes indépendantes, l'image en images et le son en millisecondes. ⚠ DÉCOUPLÉ, un enregistreur placé derrière ce délai sort décalé de la DIFFÉRENCE des deux consignes : il apparie l'image k avec le son du même instant. C'est le but du découplage (régler l'un sans l'autre), mais l'ISO en portera la trace.",
      "default": true,
      "scope": "user",
      "visible_if": {
        "mode": "video_audio"
      }
    },
    {
      "key": "delay_ms_a",
      "type": "number",
      "label": "Délai audio initial (ms)",
      "help": "Utilisé seulement quand l'image et le son sont découplés.",
      "min": 0,
      "max": 10000,
      "default": 0,
      "scope": "user",
      "visible_if": {
        "av_link": false
      }
    },
    {
      "key": "max_delay_frames",
      "type": "number",
      "label": "Délai max (images vidéo · ms si audio seul)",
      "min": 1,
      "max": 10000,
      "default": 25
    },
    {
      "key": "delay_frames",
      "type": "number",
      "label": "Délai initial (images vidéo · ms si audio seul)",
      "min": 0,
      "max": 10000,
      "default": 0,
      "scope": "user"
    },
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique. À délai nul : suit le grain de tête de la source ; à délai ≥ 1 image : republie le grain retardé bande par bande.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de log",
      "help": "Verbosité du journal du conteneur. Défaut « Événements » : les faits marquants (démarrage/arrêt, changement de format, reconnexion, repli sur un chemin dégradé, entrée qui apparaît ou disparaît) sont TOUJOURS écrits — après une panne le journal doit permettre de reconstituer l'histoire, et élever le niveau après coup ne récupère rien. Les métriques périodiques (fps, compteurs) ne sont PAS journalisées : elles sont déjà publiées sur :8080. « Détaillé » = lance-flammes par trame, à n'activer que le temps d'un diagnostic (le journal Docker n'est pas roté).",
      "options": [
        {
          "value": "debug",
          "label": "Détaillé (par trame — diagnostic ponctuel)"
        },
        {
          "value": "info",
          "label": "Événements (défaut)"
        },
        {
          "value": "warning",
          "label": "Anomalies seules"
        },
        {
          "value": "error",
          "label": "Erreurs seules"
        }
      ],
      "default": "info",
      "scope": "user"
    }
  ],
  "wiring": {
    "produces": [
      {
        "repeat": "video_channels",
        "essence": "video",
        "shm": "{hostname}_{i1}",
        "label": "Sortie V{i1}"
      },
      {
        "repeat": "audio_channels",
        "essence": "audio",
        "shm": "{hostname}_audio_{i1}",
        "label": "Sortie A{i1}"
      }
    ],
    "consumes": [
      {
        "repeat": "video_channels",
        "essence": "video",
        "state_field": "input_v_{i1}",
        "label": "Entrée V{i1}"
      },
      {
        "repeat": "audio_channels",
        "essence": "audio",
        "state_field": "input_a_{i1}",
        "label": "Entrée A{i1}"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "endpoints": [
      "/state",
      "/params",
      "/input",
      "/channels",
      "/log_level"
    ],
    "read_endpoints": [
      "/state",
      "/channels"
    ]
  },
  "actions": [
    {
      "id": "set_delay",
      "label": "Régler le retard (global)",
      "endpoint": "/params",
      "body": {
        "all": true
      },
      "params": [
        {
          "key": "delay_frames",
          "label": "Retard (images)",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "set_delay_channel",
      "label": "Régler le retard d'un canal",
      "endpoint": "/params",
      "params": [
        {
          "key": "channel",
          "label": "Canal",
          "type": "number",
          "default": 0,
          "options_endpoint": "/channels"
        },
        {
          "key": "delay_frames",
          "label": "Retard (images)",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "set_delay_audio",
      "label": "Régler le retard AUDIO (découplé)",
      "endpoint": "/params",
      "body": {
        "all": true
      },
      "params": [
        {
          "key": "delay_ms_a",
          "label": "Retard audio (ms)",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "av_link",
      "label": "Coupler image et son",
      "endpoint": "/params",
      "params": [
        {
          "key": "av_link",
          "label": "Couplés",
          "type": "bool",
          "default": true
        }
      ],
      "feedback": {
        "state": "av_link",
        "value_from": "av_link"
      }
    },
    {
      "id": "link",
      "label": "Lier les canaux",
      "endpoint": "/params",
      "params": [
        {
          "key": "link",
          "label": "Liés",
          "type": "bool",
          "default": true
        }
      ],
      "feedback": {
        "state": "link",
        "value_from": "link"
      }
    },
    {
      "id": "log_level",
      "label": "Niveau de log (à chaud)",
      "endpoint": "/log_level",
      "params": [
        {
          "key": "level",
          "label": "Niveau",
          "type": "text",
          "default": "info",
          "options": [
            {
              "value": "debug",
              "label": "Détaillé"
            },
            {
              "value": "info",
              "label": "Événements (défaut)"
            },
            {
              "value": "warning",
              "label": "Anomalies seules"
            },
            {
              "value": "error",
              "label": "Erreurs seules"
            }
          ]
        }
      ]
    }
  ],
  "state": [
    {
      "id": "link",
      "label": "Canaux liés",
      "endpoint": "/state",
      "path": "link",
      "type": "bool"
    },
    {
      "id": "av_link",
      "label": "Image et son couplés",
      "endpoint": "/state",
      "path": "av_link",
      "type": "bool"
    }
  ],
  "param_tree": {
    "global_groups": [
      {
        "label": "Retard",
        "endpoint": "/params",
        "caps": "delay_fields",
        "fields": {
          "delay_frames": {
            "label": "Retard image (images)",
            "type": "number",
            "min": 0,
            "max": 10000,
            "default": 0,
            "path": "delay_frames"
          },
          "delay_ms_a": {
            "label": "Retard son (ms)",
            "type": "number",
            "min": 0,
            "max": 10000,
            "default": 0,
            "path": "delay_ms_a"
          }
        }
      },
      {
        "label": "Couplage image/son",
        "endpoint": "/params",
        "fields": {
          "av_link": {
            "label": "Image et son couplés",
            "type": "bool",
            "default": true,
            "path": "av_link"
          }
        }
      },
      {
        "label": "Journal (diagnostic)",
        "endpoint": "/log_level",
        "fields": {
          "level": {
            "label": "Niveau de log",
            "type": "enum",
            "options": [
              "debug",
              "info",
              "warning",
              "error"
            ],
            "default": "info",
            "path": "log_level"
          }
        }
      }
    ]
  }
}
